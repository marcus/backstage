#!/usr/bin/env ruby
# frozen_string_literal: true

paths = ARGV
abort "usage: scan-secrets PATH..." if paths.empty?

names = ENV.keys.grep(/(?:^|_)(?:TOKEN|SECRET|PASSWORD|CREDENTIAL)(?:$|_)|API_?KEY|AUTHORIZATION/i)
secrets = names.to_h { |name| [name, ENV[name].to_s] }.reject { |_name, value| value.empty? }
files = paths.flat_map { |path| File.directory?(path) ? Dir[File.join(path, "**", "*")].select { |item| File.file?(item) } : path }.uniq
matches = []
files.each do |path|
  content = File.binread(path)
  secrets.each { |name, secret| matches << [name, path] if content.include?(secret) }
end

if matches.empty?
  puts "credential scan clean: #{files.length} files, #{secrets.length} configured values"
  exit 0
end

matches.each { |name, path| warn "credential value #{name} found in #{path}" }
exit 1
